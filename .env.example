# Токен бота из @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Альтернатива: путь к файлу с токеном (например, docker secret)
# BOT_TOKEN_FILE=/run/secrets/bot_token

# Где хранить базу при локальном запуске (python -m app).
# В docker-compose путь всегда /data/birthdays.db (том bot-data).
DB_PATH=data/birthdays.db

# Значения по умолчанию для новых чатов
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_REMINDER_TIME=09:00

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Часовой пояс контейнера (нужен только для логов)
TZ=Europe/Moscow
