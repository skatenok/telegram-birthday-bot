# Токен бота из @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Альтернатива: путь к файлу с токеном
# BOT_TOKEN_FILE=/run/secrets/bot_token

# Значения по умолчанию для новых чатов
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_REMINDER_TIME=09:00

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Часовой пояс контейнера (влияет на время в логах)
TZ=Europe/Moscow

# Путь к базе для локального запуска (по умолчанию data/birthdays.db).
# В Docker всегда используется /data/birthdays.db — не задавайте здесь другой путь.
# DB_PATH=data/birthdays.db
